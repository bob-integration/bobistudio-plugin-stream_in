{
  "type": "stream_in",
  "label": "Stream In",
  "runtime": "docker",
  "image": "media",
  "version": "0.2.1",
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "nav": {
    "section": "sources",
    "label": "Sources",
    "order": 20
  },
  "resources": {
    "cores": 2,
    "memory": 1024,
    "pin": true
  },
  "deploy_defaults": {
    "mode": "srt_listener",
    "url": "",
    "listen_port": 9000,
    "srt_latency_ms": 200,
    "srt_passphrase": "",
    "srt_streamid": "",
    "rtmp_app": "live",
    "rtmp_key": "",
    "ingest_network": "",
    "width": 1920,
    "height": 1080,
    "fps": 50,
    "chroma": "422",
    "bit_depth": 8,
    "scan": "p",
    "field_order": "tff",
    "genlock": true,
    "genlock_phase_ms": 0.0,
    "idle_mode": "bars",
    "freeze_timeout_ms": 1000,
    "enabled": true
  },
  "config_schema": [
    {
      "key": "mode",
      "type": "select",
      "label": "Mode d'ingest",
      "default": "srt_listener",
      "help": "Écoute : la source pousse vers l'adresse affichée sur la page du plugin. Appel/pull : le plugin va chercher le flux.",
      "options": [
        {
          "value": "srt_listener",
          "label": "SRT — écoute (la source pousse)"
        },
        {
          "value": "srt_caller",
          "label": "SRT — appel (on tire une source distante)"
        },
        {
          "value": "rtmp_server",
          "label": "RTMP — serveur (push OBS/encodeur)"
        },
        {
          "value": "rtmp_pull",
          "label": "RTMP — pull (flux distant)"
        }
      ],
      "scope": "system"
    },
    {
      "key": "srt_latency_ms",
      "type": "number",
      "label": "Latence SRT (ms)",
      "min": 20,
      "max": 8000,
      "default": 200,
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "srt_passphrase",
      "type": "text",
      "label": "Passphrase SRT",
      "placeholder": "facultative",
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "srt_streamid",
      "type": "text",
      "label": "Stream ID SRT",
      "placeholder": "facultatif",
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "genlock",
      "type": "checkbox",
      "label": "Genlock (grille PTP)",
      "default": true,
      "scope": "system"
    },
    {
      "key": "idle_mode",
      "type": "select",
      "label": "Image sans flux",
      "default": "bars",
      "options": [
        {
          "value": "bars",
          "label": "Mire (barres)"
        },
        {
          "value": "black",
          "label": "Noir"
        }
      ],
      "scope": "user"
    },
    {
      "key": "freeze_timeout_ms",
      "type": "number",
      "label": "Seuil de gel (ms)",
      "min": 100,
      "max": 30000,
      "default": 1000,
      "help": "Au-delà, la dernière image est répétée et l'état passe à « gelé ».",
      "scope": "user"
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}"
      },
      {
        "essence": "audio",
        "shm": "{hostname}_audio"
      }
    ],
    "consumes": [],
    "mode": "redeploy"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/reconnect",
      "/source",
      "/enable",
      "/events",
      "/events/clear"
    ],
    "read_endpoints": [
      "/state",
      "/events"
    ]
  },
  "store": {
    "unique_name": true
  }
}
