{
  "type": "stream_in",
  "label": "Stream In",
  "runtime": "docker",
  "image": "media",
  "version": "0.4.0",
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "nav": {
    "section": "sources",
    "label": "Sources",
    "order": 20
  },
  "resources": {
    "cores": 2,
    "memory": 1024,
    "pin": true
  },
  "deploy_defaults": {
    "mode": "srt_listener",
    "url": "",
    "listen_port": 9000,
    "srt_latency_ms": 200,
    "srt_passphrase": "",
    "srt_streamid": "",
    "rtmp_app": "live",
    "rtmp_key": "",
    "ingest_network": "",
    "width": 1920,
    "height": 1080,
    "fps": 50,
    "chroma": "422",
    "bit_depth": 8,
    "scan": "p",
    "field_order": "tff",
    "genlock": true,
    "genlock_phase_ms": 0.0,
    "idle_mode": "bars",
    "freeze_timeout_ms": 1000,
    "enabled": true,
    "log_level": "info"
  },
  "config_schema": [
    {
      "key": "mode",
      "type": "select",
      "label": "Mode d'ingest",
      "default": "srt_listener",
      "help": "Écoute : la source pousse vers l'adresse affichée sur la page du plugin. Appel/pull : le plugin va chercher le flux.",
      "options": [
        {
          "value": "srt_listener",
          "label": "SRT — écoute (la source pousse)"
        },
        {
          "value": "srt_caller",
          "label": "SRT — appel (on tire une source distante)"
        },
        {
          "value": "rtmp_server",
          "label": "RTMP — serveur (push OBS/encodeur)"
        },
        {
          "value": "rtmp_pull",
          "label": "RTMP — pull (flux distant)"
        }
      ],
      "scope": "system"
    },
    {
      "key": "srt_latency_ms",
      "type": "number",
      "label": "Latence SRT (ms)",
      "min": 20,
      "max": 8000,
      "default": 200,
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "srt_passphrase",
      "type": "text",
      "label": "Passphrase SRT",
      "placeholder": "facultative",
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "srt_streamid",
      "type": "text",
      "label": "Stream ID SRT",
      "placeholder": "facultatif",
      "visible_if": {
        "mode": [
          "srt_listener",
          "srt_caller"
        ]
      },
      "scope": "system"
    },
    {
      "key": "genlock",
      "type": "checkbox",
      "label": "Genlock (grille PTP)",
      "default": true,
      "scope": "system"
    },
    {
      "key": "idle_mode",
      "type": "select",
      "label": "Image sans flux",
      "default": "bars",
      "options": [
        {
          "value": "bars",
          "label": "Mire (barres)"
        },
        {
          "value": "black",
          "label": "Noir"
        }
      ],
      "scope": "user"
    },
    {
      "key": "freeze_timeout_ms",
      "type": "number",
      "label": "Seuil de gel (ms)",
      "min": 100,
      "max": 30000,
      "default": 1000,
      "help": "Au-delà, la dernière image est répétée et l'état passe à « gelé ».",
      "scope": "user"
    },
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}"
      },
      {
        "essence": "audio",
        "shm": "{hostname}_audio"
      }
    ],
    "consumes": [],
    "mode": "redeploy"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/reconnect",
      "/source",
      "/enable",
      "/events",
      "/events/clear"
    ],
    "read_endpoints": [
      "/state",
      "/events"
    ]
  },
  "store": {
    "unique_name": true
  },
  "state_volume": true,
  "actions": [
    {
      "id": "enable",
      "label": "Activer la réception",
      "endpoint": "/enable",
      "params": [
        {
          "key": "enabled",
          "label": "Activée",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "enabled",
        "value_from": "enabled"
      }
    },
    {
      "id": "reconnect",
      "label": "Reconnecter la source",
      "endpoint": "/reconnect",
      "params": []
    },
    {
      "id": "source_url",
      "label": "Changer l'URL de la source",
      "endpoint": "/source",
      "params": [
        {
          "key": "url",
          "label": "URL (srt://, rtmp://, …)",
          "type": "text"
        }
      ]
    }
  ],
  "state": [
    {
      "id": "enabled",
      "label": "Réception activée",
      "endpoint": "/state",
      "path": "enabled",
      "type": "bool"
    },
    {
      "id": "conn_state",
      "label": "État de connexion",
      "endpoint": "/state",
      "path": "conn_state",
      "type": "text"
    },
    {
      "id": "fps",
      "label": "FPS reçus",
      "endpoint": "/state",
      "path": "fps",
      "type": "number"
    }
  ]
}
